# Generated artifacts — regenerable, and far too large to version.
# Once a 40 MB blob enters history it is there permanently.
# a13.bin  : ./eta11 1000000000 11   (~7 min on 8 cores)
# state*.bin: checkpoint, tied to a specific MMAX — delete it when MMAX changes.
#             Globbed: state_1e10.bin was committed once because this line read
#             "state.bin" and the file had been renamed. 397 MB, removed by
#             rewriting history before the first push.
a13*.bin
state*.bin
eta11
# res_<l>.bin: p(n) mod l for n <= NMAX; ./pgen 30000000 regenerates in ~2 min
res_*.bin
pgen

# Run logs. The numbers that matter are transcribed into results/EXPECTED.md,
# which is versioned; the logs themselves are regenerable.
results/*.log

__pycache__/
*.pyc
.DS_Store

# The manuscript and its checker are kept out of the public repository: a paper
# is not a thing to publish as a git tree. They live here locally and in
# ~/coding/eta11-mod-13-full-history.bundle, which holds the history from before
# paper/ was removed.
paper/
